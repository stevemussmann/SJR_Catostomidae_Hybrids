pAll <- ggplot(dlengthData, aes(x=TL, fill=Hybrid_Generation2)) +
geom_histogram(position="stack", binwidth=10) + custom_colors +
theme(axis.text = element_text(size=14), legend.position=c(0.9,0.8), legend.background = element_rect(fill="white", linewidth=0.5, linetype="solid", color="black"), panel.grid.major = element_blank(), panel.grid.minor = element_blank(), panel.background = element_blank(), axis.line = element_line(colour = "black"), plot.title = element_text(vjust = -8, hjust=0.1, size=20))
pAll
# set bins for presenting data
lengths = seq(from = 0, to = 650, by = 30)
#labs = lengths[-length(lengths)] # to remove last element of list
labs = lengths[-1]
#dlengthData <- dlengthData %>% modify_if(is.character, as.factor)
df <- dlengthData %>% as_tibble() %>% mutate(bin = cut(TL, breaks = lengths,labels=labs)) %>% arrange(TL)
#df <- df %>% modify_if(is.character, as.factor)
df <- df %>% mutate_at(vars(bin), factor)
df
df <- as.data.frame(df %>% group_by(bin, Hybrid_Generation2) %>% count() %>% ungroup() %>% group_by(bin) %>%
mutate(ttl = sum(n), pct_ttl = n / ttl) %>%
ungroup() )
write_csv(df, "table.csv")
df <- read.table("table.csv", header=TRUE, sep=",")
